+                try modelContext.fetch(FetchDescriptor<TrackedKeywordRefreshStatus>()).count == 2
+            )
+            #expect(
+                try modelContext.fetch(FetchDescriptor<EstimatedKeywordDifficultyMetric>()).count
+                    == 2
+            )
+            #expect(
+                try modelContext.fetch(
+                    FetchDescriptor<EstimatedKeywordDifficultyResultEvidenceRecord>()
+                ).count == 5
+            )
+
+            let statuses = try modelContext.fetch(FetchDescriptor<TrackedKeywordRefreshStatus>())
+            #expect(Set(statuses.compactMap(\.domain)) == Set([.ranking, .popularity]))
+            let difficulties = try modelContext.fetch(
+                FetchDescriptor<EstimatedKeywordDifficultyMetric>()
+            )
+            #expect(Set(difficulties.compactMap(\.state)) == Set([.estimated, .unavailable]))
+            let evidence = try modelContext.fetch(
+                FetchDescriptor<EstimatedKeywordDifficultyResultEvidenceRecord>()
+            )
+            #expect(Set(evidence.map(\.calculationID)) == Set([
+                estimatedCalculationID,
+                unavailableCalculationID,
+            ]))
+        }
+
+        let storeArtifacts = try fileManager.contentsOfDirectory(
+            at: outputDirectory,
+            includingPropertiesForKeys: [.fileSizeKey, .isRegularFileKey],
+            options: [.skipsHiddenFiles]
+        )
+        .filter { $0.lastPathComponent.hasPrefix("default.store") }
+        .sorted { $0.lastPathComponent < $1.lastPathComponent }
+
+        var artifacts: [[String: Any]] = []
+        for artifactURL in storeArtifacts {
+            let data = try Data(contentsOf: artifactURL, options: [.mappedIfSafe])
+            if data.isEmpty, artifactURL.lastPathComponent != "default.store" {
+                try fileManager.removeItem(at: artifactURL)
+                continue
+            }
+            guard !data.isEmpty else {
+                throw FixtureGenerationError.emptyStore
+            }
+            let digest = SHA256.hash(data: data)
+                .map { String(format: "%02x", Int($0)) }
+                .joined()
+            artifacts.append([
+                "filename": artifactURL.lastPathComponent,
+                "byteCount": data.count,
+                "sha256": digest
+            ])
+        }
+        guard artifacts.contains(where: { ($0["filename"] as? String) == "default.store" }) else {
+            throw FixtureGenerationError.missingStore
+        }
+
+        let manifest: [String: Any] = [
+            "formatVersion": 2,
+            "fixtureID": "77bc4c3-v4",
+            "sourceCommit": "77bc4c39735f8d68376347f671fd4c8ac34d684c",
+            "sourceTree": "f99c6e8349b253e8220b8dae9258059e3c8ab455",
+            "schemaVersion": "4.0.0",
+            "storeFilename": "default.store",
+            "artifacts": artifacts
+        ]
+        let manifestData = try JSONSerialization.data(
+            withJSONObject: manifest,
+            options: [.prettyPrinted, .sortedKeys]
+        )
+        try manifestData.write(
+            to: outputDirectory.appendingPathComponent("manifest.json"),
+            options: .atomic
+        )
+    }
+}
+
+private enum FixtureGenerationError: LocalizedError {
+    case missingOutputDirectory(String)
+    case unsafeOutputDirectory(String)
+    case outputDirectoryNotEmpty(String)
+    case emptyStore
+    case missingStore
+
+    var errorDescription: String? {
+        switch self {
+        case .missingOutputDirectory(let key):
+            return "Set \(key) to an isolated temporary output directory."
+        case .unsafeOutputDirectory(let path):
+            return "Fixture output must be below the system temporary directory: \(path)"
+        case .outputDirectoryNotEmpty(let path):
+            return "Fixture output directory must be empty: \(path)"
+        case .emptyStore:
+            return "The released SwiftData store is empty."
+        case .missingStore:
+            return "The released SwiftData generator did not create default.store."
+        }
+    }
+}
